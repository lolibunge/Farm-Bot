{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/telegram/*.js": {
      "maxDuration": 30
    },
    "api/reminders.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/admin-v2/stock-dashboard", "destination": "/api/admin-v2/horses?_view=stock" },
    { "source": "/api/admin-v2/owner-ledger", "destination": "/api/admin-v2/owners?resource=ledger" },
    { "source": "/api/admin-v2/owner-statement", "destination": "/api/admin-v2/owners?resource=statement" },
    { "source": "/api/admin-v2/owner-feed-purchases", "destination": "/api/admin-v2/owners?resource=feed-purchases" },
    { "source": "/api/admin-v2/owner-expense-split", "destination": "/api/admin-v2/owners?resource=expense-split" },
    { "source": "/api/admin-v2/owner-expense-split-drafts", "destination": "/api/admin-v2/owners?resource=expense-split-drafts" },
    { "source": "/api/admin-v2/general-expenses", "destination": "/api/admin-v2/owners?resource=general-expenses" }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
