{
  "name": "farm-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:benteveo": "node --env-file=.env.benteveo index.js",
    "start:ercilia": "node --env-file=.env.ercilia index.js",
    "dev:benteveo": "node --env-file=.env.benteveo scripts/dev-local.js",
    "dev:ercilia": "node --env-file=.env.ercilia scripts/dev-local.js",
    "build": "esbuild admin-v2/app.js --minify --legal-comments=none --outfile=admin-v2/app.min.js && esbuild admin-v2/styles.css --minify --outfile=admin-v2/styles.min.css",
    "watch": "esbuild admin-v2/app.js --minify --legal-comments=none --outfile=admin-v2/app.min.js --watch & esbuild admin-v2/styles.css --minify --outfile=admin-v2/styles.min.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolibunge/Farm-Bot.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lolibunge/Farm-Bot/issues"
  },
  "homepage": "https://github.com/lolibunge/Farm-Bot#readme",
  "dependencies": {
    "dotenv": "^17.3.1",
    "pg": "^8.20.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "allowScripts": {
    "esbuild": true
  }
}
